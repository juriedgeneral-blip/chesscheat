{
  "manifest_version": 3,
  "name": "Chesscheat",
  "version": "1.4",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "description": "Always see the optimal move in any chess.com game. Runs locally.",
  "permissions": ["storage", "offscreen"],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "js": ["scripts/main.js", "scripts/optimal.js"],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["scripts/stockfish.asm.1abfa10c.js"],
      "matches": ["https://*.chess.com/*"]
    }
  ]
}
